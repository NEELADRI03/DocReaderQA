# =============================================================

# DocQA environment variables

# Copy this file to .env and adjust the values:

#   Copy-Item .env.example .env

# Never commit .env. Never put real secrets in this file.

# =============================================================

# ---------- App ----------

# development | production (turns dev-only endpoints on/off)

APP_ENV=development

# ---------- PostgreSQL (read by the postgres container) ----------

# User, password and database created on the first start

POSTGRES_USER=docqa

POSTGRES_PASSWORD=docqa

POSTGRES_DB=docqa

# ---------- Backend: database ----------

# Async SQLAlchemy URL. Must use the same user/password/db as above.

# Host "postgres" is the compose service name. Outside Docker use localhost.

DATABASE_URL=postgresql+asyncpg://docqa:docqa@postgres:5432/docqa

# ---------- Backend: Redis job queue ----------

# Host "redis" is the compose service name. Outside Docker use localhost.

REDIS_URL=redis://redis:6379/0

# ---------- Ollama (runs on the Windows host, decision D10) ----------

OLLAMA_BASE_URL=http://host.docker.internal:11434

LLM_MODEL=qwen3:8b

EMBEDDING_MODEL=nomic-embed-text

# Must match the embedding model; fixes the VECTOR(n) column (D5)

EMBEDDING_DIM=768

# ---------- Auth ----------

# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"

JWT_SECRET=change-me

ACCESS_TOKEN_MINUTES=30

REFRESH_TOKEN_DAYS=7

# ---------- Uploads and storage ----------

# Folder inside the api/worker containers (mounted from ./storage)

STORAGE_DIR=/data/storage

MAX_UPLOAD_MB=50

MAX_PAGES=500

# ---------- CORS ----------

# Comma-separated origins allowed to call the API

CORS_ORIGINS=http://localhost:5173

# ---------- Frontend (Vite) ----------

# Only variables starting with VITE_ are visible to the browser code

VITE_API_BASE_URL=http://localhost:8000/api/v1